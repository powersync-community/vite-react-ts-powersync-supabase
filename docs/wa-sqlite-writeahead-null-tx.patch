+          // positional in the WAL file, so the only safe response is to
+          // stop advancing; a later broadcast, the backstop, or the next
+          // local write will retry once the frame is readable.
+          console.warn(`WAL txId ${nextTxId} not yet readable, deferring ` +
+            `${this.#mapIdToPendingTx.size} pending transaction(s)`);
+          break;
+        }
       }
 
