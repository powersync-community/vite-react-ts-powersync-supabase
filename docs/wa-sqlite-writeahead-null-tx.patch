       } else {
         // Read the transaction from the WAL file.
         tx = this.#readTx();
+        if (!tx) {
+          // The next transaction in sequence is neither in the pending map
+          // nor readable from the WAL file yet. This can happen because
+          // BroadcastChannel only preserves ordering per sender, so with
+          // multiple writers a transaction can arrive before its
+          // predecessor from another connection, and because commits are
